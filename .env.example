# =============================================================================
# ShaderLumen — environment template
# Copy to .env.local for local dev. Mirror values in Vercel → Production.
# =============================================================================

# --- Clerk (auth) ---
# Dashboard: https://dashboard.clerk.com/
# Docs: https://clerk.com/docs/quickstarts/react
#
# Allowed origins (Clerk → Configure → Domains):
#   http://localhost:5173
#   https://shaderforge-one.vercel.app
#   https://YOUR_CUSTOM_DOMAIN (if configured)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_xxxxx

# --- OpenAI (ShaderLumen uses gpt-5.4-mini only) ---
# Vercel: OPENAI_API_KEY works (mapped at build). Local: use .env.local.
OPENAI_API_KEY=
VITE_OPENAI_API_KEY=
# Optional override (default: gpt-5.4-mini)
VITE_OPENAI_MODEL=gpt-5.4-mini

# --- Creem billing (Merchant of Record) ---
# Setup guide: see README or ask agent for step-by-step Creem configuration.
#
# CLIENT (baked into Vite build — redeploy after changing):
VITE_CREEM_CHECKOUT_PRO_URL=
VITE_CREEM_CHECKOUT_TEAM_URL=
#
# SERVER (Vercel only — no VITE_ prefix):
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_PRO_IDS=prod_xxxxx
CREEM_PRODUCT_TEAM_IDS=prod_yyyyy
#
# Creem dashboard URLs (replace YOUR_DOMAIN):
#   Webhook:  https://YOUR_DOMAIN/api/webhooks/creem
#   Success:  https://YOUR_DOMAIN/billing/success
#
# Smoke check: https://YOUR_DOMAIN/api/health
#   Expect: clerkPublishable, clerkSecret, creemWebhookSecret, creemProProducts

# Demo billing — instant Pro upgrade without Creem (set false for real payments)
VITE_DEMO_BILLING=true
DEMO_BILLING=true

# Legacy Stripe fallback (optional if Creem URLs unset)
VITE_STRIPE_CHECKOUT_PRO_URL=
VITE_STRIPE_CHECKOUT_TEAM_URL=