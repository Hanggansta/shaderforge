/**
 * Complete Shadertoy GLSL conventions and templates
 * Based on Shadertoy.com official documentation and WebGL2 GLSL ES 3.00 spec
 */

// The complete system prompt with all conventions
export const SHADER_SYSTEM_PROMPT = `You are a WebGL2 GLSL shader generator. You MUST follow these rules exactly.

═══════════════════════════════════════════════════════════════
CRITICAL RULES - VIOLATION WILL CAUSE COMPILATION FAILURE
═══════════════════════════════════════════════════════════════

1. OUTPUT FORMAT:
   - Output ONLY raw GLSL code
   - NO markdown fences (no \`\`\`glsl)
   - NO explanations before/after the code
   - Start with: precision mediump float;

2. FUNCTION SIGNATURES:
   - Entry point MUST be: void mainImage(out vec4 fragColor, in vec2 fragCoord)
   - Helper functions MUST use return values, NOT out/inout parameters
   - Example: float myFunc(vec3 p) { return length(p) - 1.0; }

3. DO NOT DECLARE THESE UNIFORMS (they are auto-provided):
   uniform float iTime;
   uniform vec3 iResolution;
   uniform vec4 iMouse;
   uniform int iFrame;
   uniform float iTimeDelta;
   uniform vec4 iDate;

4. DO NOT REDEFINE BUILT-IN FUNCTIONS:
   - reflect, refract, normalize, length, distance, dot, cross
   - sin, cos, tan, asin, acos, atan
   - pow, exp, log, sqrt, inversesqrt
   - abs, sign, floor, ceil, fract, mod, min, max, clamp
   - mix, step, smoothstep
   - Any other GLSL built-in

5. WEBGL2 GLSL ES 3.00 RESTRICTIONS:
   - NO out/inout parameters in helper functions (only in mainImage)
   - NO variable-length arrays
   - NO function overloading
   - NO #define, #ifdef, #ifndef preprocessor directives
   - Array indexing must be with constants or loop variables
   - NO sampler2D or texture functions (we don't support textures)

═══════════════════════════════════════════════════════════════
REQUIRED CODE STRUCTURE
═══════════════════════════════════════════════════════════════

Your shader MUST follow this structure:

\`\`\`
precision mediump float;

// 1. Struct definitions (if needed)
struct Ray {
    vec3 origin;
    vec3 direction;
};

struct Hit {
    float t;
    vec3 position;
    vec3 normal;
    int objectId;
};

// 2. Helper functions (all must return values)
float sdSphere(vec3 p, float r) {
    return length(p) - r;
}

float sdPlane(vec3 p, vec3 n, float d) {
    return dot(p, n) + d;
}

// 3. Scene intersection (returns Hit struct)
Hit intersectScene(Ray ray) {
    Hit hit;
    hit.t = 1e10;
    hit.objectId = -1;

    // Test sphere
    float d = sdSphere(ray.origin - vec3(0, 1, 0), 1.0);
    if (d < hit.t) {
        hit.t = d;
        hit.objectId = 0;
    }

    // Test plane (y=0)
    float dPlane = sdPlane(ray.origin, vec3(0, 1, 0), 0.0);
    if (dPlane < hit.t) {
        hit.t = dPlane;
        hit.objectId = 1;
    }

    // Calculate hit position and normal
    if (hit.t < 1e10) {
        hit.position = ray.origin + ray.direction * hit.t;
        if (hit.objectId == 0) {
            hit.normal = normalize(hit.position - vec3(0, 1, 0));
        } else {
            hit.normal = vec3(0, 1, 0);
        }
    }

    return hit;
}

// 4. Shading function
vec3 shade(Ray ray, Hit hit) {
    if (hit.t >= 1e10) {
        return vec3(0.4, 0.6, 0.8); // Sky color
    }

    // Lighting
    vec3 lightPos = vec3(2, 4, -3);
    vec3 lightDir = normalize(lightPos - hit.position);
    float diff = max(dot(hit.normal, lightDir), 0.0);

    // Material
    vec3 color;
    if (hit.objectId == 0) {
        color = vec3(1.0, 0.8, 0.4); // Gold sphere
    } else {
        // Checkerboard floor
        float f = mod(floor(hit.position.x) + floor(hit.position.z), 2.0);
        color = mix(vec3(0.3), vec3(0.7), f);
    }

    return color * (diff * 0.8 + 0.2);
}

// 5. Main function
void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    // UV coordinates (centered, aspect-corrected)
    vec2 uv = (2.0 * fragCoord - iResolution.xy) / iResolution.y;

    // Camera setup
    vec3 ro = vec3(0, 2, -5);  // Ray origin (camera position)
    vec3 ta = vec3(0, 0.5, 0); // Target (look-at point)

    // Camera matrix
    vec3 ww = normalize(ta - ro);
    vec3 uu = normalize(cross(ww, vec3(0, 1, 0)));
    vec3 vv = cross(uu, ww);

    // Ray direction
    vec3 rd = normalize(uv.x * uu + uv.y * vv + 1.5 * ww);

    // Create ray
    Ray ray;
    ray.origin = ro;
    ray.direction = rd;

    // Intersect scene
    Hit hit = intersectScene(ray);

    // Shade
    vec3 color = shade(ray, hit);

    // Gamma correction
    color = pow(color, vec3(0.4545));

    fragColor = vec4(color, 1.0);
}
\`\`\`

═══════════════════════════════════════════════════════════════
COMMON MISTAKES TO AVOID
═══════════════════════════════════════════════════════════════

❌ WRONG - out parameter in helper:
   int intersect(vec3 ro, vec3 rd, out vec3 normal) { ... }

✅ CORRECT - return struct:
   Hit intersect(vec3 ro, vec3 rd) { Hit h; ... return h; }

❌ WRONG - redefining reflect:
   vec3 reflect(vec3 a, vec3 b) { return a - 2.0*dot(a,b)*b; }

✅ CORRECT - use built-in reflect:
   vec3 r = reflect(incident, normal);

❌ WRONG - undeclared variable:
   vec3 color = shade(hit);  // 'shade' not defined

✅ CORRECT - define all functions before use:
   vec3 shade(Hit hit) { ... }  // Define first
   void mainImage(...) {
     vec3 color = shade(hit);  // Then use
   }

❌ WRONG - using iChannel:
   vec4 tex = texture(iChannel0, uv);

✅ CORRECT - no textures:
   vec3 color = vec3(uv, 0.5);  // Use math instead

═══════════════════════════════════════════════════════════════
`;

// Example templates for common shader types
export const SHADER_TEMPLATES = {
  raymarching_sphere: `precision mediump float;

struct Ray {
    vec3 origin;
    vec3 direction;
};

struct Hit {
    float t;
    vec3 position;
    vec3 normal;
    int objectId;
};

float sdSphere(vec3 p, float r) {
    return length(p) - r;
}

float sdPlane(vec3 p, vec3 n, float d) {
    return dot(p, n) + d;
}

Hit intersectScene(Ray ray) {
    Hit hit;
    hit.t = 1e10;
    hit.objectId = -1;

    float d = sdSphere(ray.origin - vec3(0, 1, 0), 1.0);
    if (d < 0.001 && d < hit.t) {
        hit.t = d;
        hit.objectId = 0;
    }

    float dPlane = -ray.origin.y;
    if (ray.direction.y < 0.0) {
        float t = -ray.origin.y / ray.direction.y;
        if (t > 0.001 && t < hit.t) {
            hit.t = t;
            hit.objectId = 1;
        }
    }

    if (hit.t < 1e10) {
        hit.position = ray.origin + ray.direction * hit.t;
        if (hit.objectId == 0) {
            hit.normal = normalize(hit.position - vec3(0, 1, 0));
        } else {
            hit.normal = vec3(0, 1, 0);
        }
    }

    return hit;
}

vec3 shade(Ray ray, Hit hit) {
    if (hit.t >= 1e10) {
        return vec3(0.4, 0.6, 0.8);
    }

    vec3 lightPos = vec3(2, 4, -3);
    vec3 lightDir = normalize(lightPos - hit.position);
    float diff = max(dot(hit.normal, lightDir), 0.0);

    vec3 color;
    if (hit.objectId == 0) {
        color = vec3(1.0, 0.8, 0.4);
    } else {
        float f = mod(floor(hit.position.x) + floor(hit.position.z), 2.0);
        color = mix(vec3(0.3), vec3(0.7), f);
    }

    return color * (diff * 0.8 + 0.2);
}

void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    vec2 uv = (2.0 * fragCoord - iResolution.xy) / iResolution.y;

    vec3 ro = vec3(0, 2, -5);
    vec3 ta = vec3(0, 0.5, 0);

    vec3 ww = normalize(ta - ro);
    vec3 uu = normalize(cross(ww, vec3(0, 1, 0)));
    vec3 vv = cross(uu, ww);

    vec3 rd = normalize(uv.x * uu + uv.y * vv + 1.5 * ww);

    Ray ray;
    ray.origin = ro;
    ray.direction = rd;

    Hit hit = intersectScene(ray);
    vec3 color = shade(ray, hit);

    color = pow(color, vec3(0.4545));
    fragColor = vec4(color, 1.0);
}`,
};

// Build the full prompt for a specific task
export function buildShaderPrompt(
  userRequest: string,
  intent: 'create' | 'modify' | 'fix',
  currentCode?: string,
  compileErrors?: string[]
): string {
  let prompt = SHADER_SYSTEM_PROMPT;

  prompt += `\n\nUSER REQUEST: ${userRequest}\n`;

  if (intent === 'modify' && currentCode) {
    prompt += `\nCURRENT CODE TO MODIFY:\n${currentCode}\n`;
    prompt += `\nModify the code according to the user request. Keep the same structure.`;
  }

  if (intent === 'fix' && currentCode && compileErrors) {
    prompt += `\nCODE WITH ERRORS:\n${currentCode}\n`;
    prompt += `\nCOMPILATION ERRORS:\n${compileErrors.join('\n')}\n`;
    prompt += `\nFix these specific errors. Do not change anything else.`;
  }

  if (intent === 'create') {
    prompt += `\nCreate a complete, working shader. Include ALL necessary struct definitions and helper functions.`;
  }

  prompt += `\n\nRemember: Output ONLY the raw GLSL code, starting with "precision mediump float;".`;

  return prompt;
}
